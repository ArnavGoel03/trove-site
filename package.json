{
  "name": "toolbox-site",
  "version": "0.1.0",
  "private": true,
  "//type": "Every config here is .mjs or .ts, so there is no CommonJS to break. Without this Node reparses each .ts test as ESM after failing to read it as CJS, and warns on every run.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "check:hardcoded": "node scripts/check-hardcoded.mjs",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "prebuild": "node scripts/check-hardcoded.mjs",
    "build": "next build",
    "start": "next start",
    "check": "pnpm check:hardcoded && pnpm test && pnpm build"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "lucide-react": "^0.460.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.185.4",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
